{
  "name": "codeforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply codeforge_db --local",
    "db:remote": "wrangler d1 migrations apply codeforge_db --remote"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "vite": "^5.4.10",
    "wrangler": "^3.87.0"
  }
}
